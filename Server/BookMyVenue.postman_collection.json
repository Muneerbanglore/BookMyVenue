          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/maps/directions?origin=DubaiMall&destination=DubaiMarina",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "maps",
                "directions"
              ],
              "query": [
                {
                  "key": "origin",
                  "value": "DubaiMall"
                },
                {
                  "key": "destination",
                  "value": "DubaiMarina"
                }
              ]
            },
            "description": "Fetches route polyline coordinates and directions between origin and destination securely."
          },
          "response": []
        },
        {
          "name": "Geocode / Reverse Geocode",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/maps/geocode?latlng=25.2048,55.2708",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "maps",
                "geocode"
              ],
              "query": [
                {
                  "key": "latlng",
                  "value": "25.2048,55.2708"
                }
              ]
            },
            "description": "Converts coordinates (latitude/longitude) to address details or vice-versa securely using backend proxy."
          },
          "response": []
        }
      ]
    }
  ],
