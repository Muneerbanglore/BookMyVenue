# Server configuration
PORT=5000
NODE_ENV=development

# JWT secrets
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=24h

# Encryption secrets (32 bytes key in hex for AES-256-CBC)
ENCRYPTION_KEY=your_32_byte_hex_encryption_key_here

# Redis configuration (for BullMQ queues)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here

# Firebase configuration
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_PRIVATE_KEY="your_firebase_private_key_here"

# Google Maps API Proxy Key
Google_Map_Api=your_google_maps_api_key_here

# SMTP Server configurations (Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM=your_email@gmail.com

# Twilio SMS configurations
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here
